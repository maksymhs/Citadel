    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "jsqr": "^1.4.0",
    "node-pty": "^1.1.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.22.0",
