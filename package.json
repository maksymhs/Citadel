{
  "name": "citadel",
  "version": "0.33.2",
  "description": "Self-hosted, ultralight and secure web platform to manage projects, persistent terminals and CLI agents on a VPS",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "CITADEL_SELF_UPDATE=0 node --test",
    "doctor": "node scripts/doctor.js",
    "sentinel": "node scripts/sentinel.js",
    "mcp": "node scripts/citadel-mcp.js",
    "postinstall": "node scripts/copy-vendor.js",
    "lint": "eslint ."
  },
  "keywords": [
    "citadel",
    "vps",
    "dashboard",
    "terminal",
    "pty",
    "tmux",
    "ai-agents",
    "claude-code",
    "codex",
    "opencode"
  ],
  "author": "Citadel Contributors",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
