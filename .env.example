# NexusVPS Configuration
# Copia este archivo a .env y ajusta los valores según tu entorno

# Red y Servidor
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Seguridad y Sesiones
# Se generará uno aleatorio automáticamente si se deja vacío en el primer arranque
SESSION_SECRET=

# Rutas persistentes
DATABASE_PATH=./data/nexusvps.db
PROJECTS_DIR=./data/projects
LOGS_DIR=./data/logs

# Orígenes permitidos para WebSocket y CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Integraciones opcionales
# Caddy Proxy (desactivado si no está disponible)
ENABLE_CADDY=auto
CADDY_ADMIN_API=http://127.0.0.1:2019

# Docker (desactivado si no está disponible o sin permisos)
ENABLE_DOCKER=auto
DOCKER_SOCKET=/var/run/docker.sock
