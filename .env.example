# Citadel Configuration
# Copy this file to .env and adjust the values for your environment

# Network and Server
PORT=3000
# 127.0.0.1 keeps the panel local-only. Set 0.0.0.0 (or a LAN IP) to allow other
# devices on your network to connect — install.sh --lan does this for you.
HOST=127.0.0.1
NODE_ENV=development

# Security and Sessions
# A random value will be generated automatically if left empty on first startup
SESSION_SECRET=

# Reverse-proxy trust for X-Forwarded-* headers (client IP, protocol).
# Default loopback: only 127.0.0.1/::1 proxies are trusted, so a directly
# connected client cannot spoof its IP. Set a comma-separated list of proxy
# IPs/CIDRs when Citadel sits behind a proxy on another host. `false`/`none`
# disables it; `true` trusts everyone and should only be used when the app is
# not directly reachable.
CITADEL_TRUST_PROXY=loopback

# Scoped credential for task-mesh workers (sentinels): grants ONLY task
# claim/result/heartbeat. Set the same long random value here and in each
# sentinel's CITADEL_NODE_TOKEN. Leave empty to require full panel sessions.
# This is one installation-wide secret: every node presents it and the node id
# it declares is trusted. Safe only when all nodes belong to the same operator.
CITADEL_NODE_TOKEN=

# Per-node credentials (preferred when nodes are not all trusted): comma-
# separated "nodeId:token" pairs, each token at least 16 chars, node id
# [A-Za-z0-9._-]. Example (generate a different random token per node):
#   CITADEL_NODE_TOKENS=vps-1:<random>,vps-2:<random>
# Each sentinel still uses CITADEL_NODE_TOKEN (its own value) and can only
# claim/heartbeat/report as the node id its token is bound to. When this is
# set, the shared CITADEL_NODE_TOKEN above is IGNORED for worker endpoints so
# identity binding never silently degrades to the shared secret. If this is set
# but every entry is malformed/short, the server fails closed: worker node-token
# auth is disabled (shared token NOT used) and an error is logged until fixed.
# Rotate or revoke by editing this value and restarting the server.
CITADEL_NODE_TOKENS=

# Key used to encrypt stored Git provider tokens (64 hex characters).
# If empty, a key file (secret.key, 0600) is generated automatically in the data directory.
CITADEL_SECRET_KEY=

# Persistent paths
DATABASE_PATH=./data/citadel.db
PROJECTS_DIR=./data/projects
LOGS_DIR=./data/logs
# Allowed origins for WebSocket and CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional privileged user for the in-panel "System Terminal".
# Must be a valid Linux username (validated on startup) and an existing account.
# If set (e.g. ubuntu), host terminals run as that OS user via sudo and the
# panel becomes root-capable. Leave empty to keep terminals unprivileged;
# install.sh --admin-terminal[=user] configures this opt-in.
TERMINAL_ADMIN_USER=

# Shared, world-readable directory used as the install HOME for CLI agents
# (opencode, claude, codex…). Installing an agent once here makes it available
# to every OS user; the panel also symlinks the binary into /usr/local/bin.
CITADEL_AGENTS_DIR=/opt/citadel/agents

# Self-update settings. UPDATE_REPO is "owner/name" checked for new releases;
# UPDATE_BRANCH is the git ref the updater pulls from.
CITADEL_REPO=maksymhs/Citadel
CITADEL_REPO_BRANCH=main
# Path to the root-owned updater helper installed by install.sh --enable-updater
# (opt-in; disabled by default). The server refuses to execute it unless it is a
# regular, root-owned file that is not group/world-writable.
CITADEL_UPDATER_PATH=/usr/local/sbin/citadel-update

# Synchronized updates across hosts. CITADEL_PEERS is a comma-separated list of
# peer base URLs. When CITADEL_PEER_TOKEN is set, triggering an update here also
# asks each peer to update itself. The token must be identical on every host and
# is sent in the X-Citadel-Peer-Token header (never commit a real token).
CITADEL_PEERS=
CITADEL_PEER_TOKEN=

# Public URL encoded in the panel's "Connect from your phone" QR code. Leave
# empty to auto-detect: a Tailscale (*.ts.net) address first, then the LAN IP.
# Set it explicitly (e.g. https://panel.example.com) to pin a stable address.
CITADEL_PUBLIC_URL=

# Optional integrations
# Caddy Proxy (disabled if unavailable)
ENABLE_CADDY=auto
CADDY_ADMIN_API=http://127.0.0.1:2019

# Docker (disabled if unavailable or without permissions)
ENABLE_DOCKER=auto
DOCKER_SOCKET=/var/run/docker.sock

# Docker Compose trial only: host loopback port (container still listens on 3000).
# CITADEL_TRIAL_PORT=3001
