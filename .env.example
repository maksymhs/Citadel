# Citadel Configuration
# Copy this file to .env and adjust the values for your environment

# Network and Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Security and Sessions
# A random value will be generated automatically if left empty on first startup
SESSION_SECRET=

# Key used to encrypt stored Git provider tokens (64 hex characters).
# If empty, a key file (secret.key, 0600) is generated automatically in the data directory.
CITADEL_SECRET_KEY=

# Persistent paths
DATABASE_PATH=./data/citadel.db
PROJECTS_DIR=./data/projects
LOGS_DIR=./data/logs

# Allowed origins for WebSocket and CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional integrations
# Caddy Proxy (disabled if unavailable)
ENABLE_CADDY=auto
CADDY_ADMIN_API=http://127.0.0.1:2019

# Docker (disabled if unavailable or without permissions)
ENABLE_DOCKER=auto
DOCKER_SOCKET=/var/run/docker.sock
