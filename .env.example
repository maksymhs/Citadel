# Citadel Configuration
# Copy this file to .env and adjust the values for your environment

# Network and Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Security and Sessions
# A random value will be generated automatically if left empty on first startup
SESSION_SECRET=

# Key used to encrypt stored Git provider tokens (64 hex characters).
# If empty, a key file (secret.key, 0600) is generated automatically in the data directory.
CITADEL_SECRET_KEY=

# Persistent paths
DATABASE_PATH=./data/citadel.db
PROJECTS_DIR=./data/projects
LOGS_DIR=./data/logs

# Allowed origins for WebSocket and CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional privileged user for the in-panel "System Terminal".
# If set (e.g. ubuntu), host terminals run as that OS user via sudo and the
# panel becomes root-capable. Leave empty to keep terminals unprivileged.
TERMINAL_ADMIN_USER=

# Self-update settings. UPDATE_REPO is "owner/name" checked for new releases;
# UPDATE_BRANCH is the git ref the updater pulls from.
CITADEL_REPO=maksymhs/Citadel
CITADEL_REPO_BRANCH=main
# Path to the root-owned updater helper installed by "install.sh --enable-updater".
CITADEL_UPDATER_PATH=/usr/local/sbin/citadel-update

# Optional integrations
# Caddy Proxy (disabled if unavailable)
ENABLE_CADDY=auto
CADDY_ADMIN_API=http://127.0.0.1:2019

# Docker (disabled if unavailable or without permissions)
ENABLE_DOCKER=auto
DOCKER_SOCKET=/var/run/docker.sock
