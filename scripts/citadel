#!/usr/bin/env bash
# ==============================================================================
# Citadel — friendly management CLI
#   citadel status | url | qr | logs | restart | update | help
#   citadel doctor | network | wifi list | wifi connect | repair
#   citadel start | stop | menubar [on|off]   (menubar: macOS only)
#   citadel reset-password [--list | username]
#   citadel power [status|on|off]
# Installed as /usr/local/bin/citadel (a thin launcher for this file).
# ==============================================================================
set -euo pipefail

if [ "$(uname -s)" = "Darwin" ]; then
  DEFAULT_TARGET_DIR="$HOME/Library/Application Support/Citadel"
else
  DEFAULT_TARGET_DIR="/srv/citadel"
fi
APP_DIR="${CITADEL_APP_DIR:-$DEFAULT_TARGET_DIR/app}"
SERVICE="${CITADEL_SERVICE:-citadel}"
UPDATER="${CITADEL_UPDATER_PATH:-/usr/local/sbin/citadel-update}"
PORT="${PORT:-3000}"
# The panel stores the Cloudflare tunnel URL and the configured public URL under
# DATA_DIR; pass it so `citadel url|qr` resolve the same address the panel shows.
DATA_DIR="${CITADEL_DATA_DIR:-${DATA_DIR:-$DEFAULT_TARGET_DIR/data}}"
# Exported so `citadel doctor` inspects the real data directory instead of
# falling back to "$APP_DIR/data".
export DATA_DIR
OS="$(uname -s)"
MACOS_LABEL="com.citadel.server"

launchd_domain() {
  printf 'gui/%s/%s' "$(id -u)" "$MACOS_LABEL"
}

# (Re)load the launchd agent if a previous `citadel stop` unloaded it.
macos_start() {
  local plist="$HOME/Library/LaunchAgents/$MACOS_LABEL.plist"
  if ! launchctl print "$(launchd_domain)" >/dev/null 2>&1; then
    launchctl bootstrap "gui/$(id -u)" "$plist"
  fi
  launchctl enable "$(launchd_domain)" >/dev/null 2>&1 || true
  launchctl kickstart "$(launchd_domain)" >/dev/null 2>&1 || true
}

as_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    echo "ERROR: this action needs root (run with sudo)." >&2
    exit 1
  fi
}

usage() {
  cat <<EOF
Citadel CLI

  citadel status         Service, version, URL and health
  citadel doctor         Read-only host, network and Citadel diagnostics
  citadel network        Detailed network and Wi-Fi diagnosis
  citadel wifi list      List visible Wi-Fi networks (NetworkManager)
  citadel wifi connect   Connect to a saved or new Wi-Fi network
  citadel repair         List and apply supported recovery actions
  citadel power status   Show lid-close and sleep state (laptop hosts)
  citadel power on       Ignore lid close and block sleep for 24/7 operation
  citadel power off      Restore the system sleep defaults
  citadel url            Print the panel URL
  citadel qr [--url]     Print a pairing QR code in the terminal (--url: short,
                         address only, for small terminals)
  citadel logs           Follow the service logs
  citadel reset-password [--list | USER]
                         Set a new panel password offline (revokes its sessions)
  citadel start          Start the service
  citadel stop           Stop the service (until `citadel start` or the next login on macOS)
  citadel restart        Restart the service
  citadel menubar [on|off|status]
                         macOS menu bar icon: status, open dashboard, start/stop
  citadel update         Update to the latest version
  citadel tunnel         Expose the panel globally via a Cloudflare tunnel
                         (--domain=HOST --token=TOKEN for your own domain)
  citadel help           Show this help

Diagnostics options: doctor/network/wifi support --json; repair supports
--action=<id> and --yes (remote network changes also require --confirm-remote).
Run "citadel doctor --help" for details.

Environment overrides: CITADEL_APP_DIR, CITADEL_SERVICE, CITADEL_UPDATER_PATH,
CITADEL_DATA_DIR, PORT
EOF
}

panel_url() {
  if command -v node >/dev/null 2>&1 && [ -f "$APP_DIR/server/services/connectService.js" ]; then
    (cd "$APP_DIR" && DATA_DIR="$DATA_DIR" PORT="$PORT" node -e "try{process.stdout.write(require('./server/services/connectService').getConnectInfo().url)}catch(e){process.stdout.write('http://127.0.0.1:'+process.env.PORT)}" 2>/dev/null) \
      || echo "http://127.0.0.1:$PORT"
  else
    echo "http://127.0.0.1:$PORT"
  fi
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  status)
    if [ "$OS" = "Darwin" ]; then
      if launchctl print "$(launchd_domain)" >/dev/null 2>&1; then
        active="active"
      else
        active="inactive"
      fi
    else
      active="$(systemctl is-active "$SERVICE" 2>/dev/null || echo unknown)"
    fi
    version="$(node -e "process.stdout.write(require('$APP_DIR/package.json').version)" 2>/dev/null || echo '?')"
    health="not checked"
    if command -v curl >/dev/null 2>&1; then
      if curl -fsS --max-time 3 "http://127.0.0.1:$PORT/api/auth/status" >/dev/null 2>&1; then
        health="OK"
      else
        health="not responding"
      fi
    fi
    echo "Citadel"
    echo "  Service:  $active"
    echo "  Version:  v$version"
    echo "  URL:      $(panel_url)"
    echo "  Health:   $health"
    ;;

  url)
    panel_url
    ;;

  qr)
    p_url="$(panel_url)"
    if [ "${1:-}" = "--url" ]; then
      # Short code for small terminals: just the panel address, no pairing secret.
      echo "Panel QR:"
      (cd "$APP_DIR" && node scripts/print-qr.js "$p_url")
      echo "Panel URL: $p_url"
      exit 0
    fi
    pair_link="$(cd "$APP_DIR" && DATA_DIR="$DATA_DIR" PORT="$PORT" node scripts/pair-qr.js "$p_url" 2>/dev/null || true)"
    echo "Pairing QR (valid for 10 minutes):"
    (cd "$APP_DIR" && node scripts/print-qr.js "${pair_link:-$p_url}" "$p_url") || {
      echo "Tip: the pairing code does not fit this terminal. Enlarge the window, or try: citadel qr --url (short code)." >&2
      exit 1
    }
    echo "Panel URL: $p_url"
    ;;

  doctor|network|wifi|repair)
    if ! command -v node >/dev/null 2>&1; then
      echo "ERROR: Node.js is required for $cmd." >&2
      exit 1
    fi
    if [ ! -f "$APP_DIR/scripts/doctor.js" ]; then
      echo "ERROR: $APP_DIR/scripts/doctor.js not found (set CITADEL_APP_DIR)." >&2
      exit 1
    fi
    exec node "$APP_DIR/scripts/doctor.js" "$cmd" "$@"
    ;;

  reset-password)
    if ! command -v node >/dev/null 2>&1 || [ ! -f "$APP_DIR/scripts/reset-password.js" ]; then
      echo "ERROR: Node.js and $APP_DIR/scripts/reset-password.js are required (set CITADEL_APP_DIR)." >&2
      exit 1
    fi
    # Run as the account that owns the database so SQLite's -wal/-shm files do
    # not end up root-owned and lock the service out.
    db_owner="$(stat -c %U "$DATA_DIR/citadel.db" 2>/dev/null || stat -f %Su "$DATA_DIR/citadel.db" 2>/dev/null || true)"
    runner=()
    if [ -n "$db_owner" ] && [ "$db_owner" != "$(id -un)" ]; then
      runner=(sudo -u "$db_owner")
    fi
    exec ${runner[@]+"${runner[@]}"} env DATA_DIR="$DATA_DIR" DATABASE_PATH="$DATA_DIR/citadel.db" \
      node "$APP_DIR/scripts/reset-password.js" "$@"
    ;;

  power)
    if [ "$OS" = "Darwin" ]; then
      echo "24/7 power control is only available on Linux hosts." >&2
      exit 1
    fi
    if [ ! -f "$APP_DIR/scripts/power.sh" ]; then
      echo "ERROR: $APP_DIR/scripts/power.sh not found (set CITADEL_APP_DIR)." >&2
      exit 1
    fi
    case "${1:-status}" in
      on|enable|off|disable)
        as_root bash "$APP_DIR/scripts/power.sh" "$@"
        ;;
      *)
        bash "$APP_DIR/scripts/power.sh" "${1:-status}"
        ;;
    esac
    ;;

  logs)
    if [ "$OS" = "Darwin" ]; then
      touch "$DATA_DIR/logs/citadel.log"
      exec tail -f "$DATA_DIR/logs/citadel.log"
    fi
    as_root journalctl -u "$SERVICE" -f
    ;;

  start)
    if [ "$OS" = "Darwin" ]; then
      macos_start
      echo "Started $MACOS_LABEL."
      exit 0
    fi
    as_root systemctl start "$SERVICE"
    echo "Started $SERVICE."
    ;;

  stop)
    if [ "$OS" = "Darwin" ]; then
      # Unload the agent so KeepAlive does not bring it straight back.
      launchctl bootout "$(launchd_domain)" >/dev/null 2>&1 || true
      echo "Stopped $MACOS_LABEL (run: citadel start)."
      exit 0
    fi
    as_root systemctl stop "$SERVICE"
    echo "Stopped $SERVICE."
    ;;

  menubar)
    if [ "$OS" != "Darwin" ]; then
      echo "The menu bar icon is only available on macOS." >&2
      exit 1
    fi
    case "${1:-status}" in
      on|install) action=install ;;
      off|remove) action=remove ;;
      status) action=status ;;
      *) echo "Usage: citadel menubar [on|off|status]" >&2; exit 2 ;;
    esac
    exec env CITADEL_APP_DIR="$APP_DIR" CITADEL_DATA_DIR="$DATA_DIR" PORT="$PORT" CITADEL_TARGET_DIR="$(dirname "$APP_DIR")" \
      bash "$APP_DIR/scripts/menubar-macos.sh" "$action"
    ;;

  restart)
    if [ "$OS" = "Darwin" ]; then
      macos_start
      launchctl kickstart -k "$(launchd_domain)"
      echo "Restarted $MACOS_LABEL."
      exit 0
    fi
    as_root systemctl restart "$SERVICE"
    echo "Restarted $SERVICE."
    ;;

  update)
    if [ "$OS" = "Darwin" ]; then
      exec bash "$APP_DIR/scripts/install-macos.sh" --update
    fi
    as_root "$UPDATER" "$@"
    ;;

  tunnel)
    if [ "$OS" = "Darwin" ]; then
      exec env CITADEL_APP_DIR="$APP_DIR" CITADEL_DATA_DIR="$DATA_DIR" PORT="$PORT" \
        bash "$APP_DIR/scripts/tunnel-macos.sh" "$@"
    fi
    as_root bash "$APP_DIR/scripts/tunnel.sh" "$@"
    ;;

  help|--help|-h|"")
    usage
    ;;

  *)
    echo "Unknown command: $cmd" >&2
    echo "" >&2
    usage >&2
    exit 1
    ;;
esac
